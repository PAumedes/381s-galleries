/**
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "381s-galleries",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  // The Worker must only be reachable via the Access-protected custom domain:
  // admin trusts the Cf-Access-Authenticated-User-Email header, which anyone
  // could forge on workers.dev or preview URLs (no Access in front of them).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "gallery.381studios.ar", "custom_domain": true },
    // Legacy host: still routed to the Worker so old links get redirected.
    { "pattern": "session.381studios.ar", "custom_domain": true },
  ],
  // Admin-only JS (build/client/admin-assets) is never served publicly: Workers
  // Static Assets runs the Worker first for that path, and the Worker only
  // hands the file to a verified admin (app/lib/server/admin-assets.ts). The
  // Vite plugin fills in `directory` from the client build output.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/admin-assets/*", "/manifest.webmanifest"],
  },
  "vars": {
    "DRIVE_MODE": "google",
    "STUDIO_NAME": "381 Studios",
    // IANA timezone of the studio (admin dates, expiry, CSV). Invalid = Buenos Aires.
    "TIMEZONE": "America/Argentina/Buenos_Aires",
    // Canonical origin for public links/QR (never derived from the Host header).
    "PUBLIC_ORIGIN": "https://gallery.381studios.ar",
    // Comma-separated hosts that 301 to PUBLIC_ORIGIN (unset = no redirect).
    "LEGACY_HOSTS": "session.381studios.ar",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "381s-galleries",
      // Placeholder: replace with the real id from `wrangler d1 create 381s-galleries`.
      "database_id": "5aa33a23-9b94-45dd-a3b8-11305cd8affb",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CACHE",
      "bucket_name": "381s-galleries-cache",
    },
  ],
  "triggers": {
    // 15 min: Drive sync. 1 min: R2 cache warming (cheap no-op when nothing is stale).
    "crons": ["*/15 * * * *", "* * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
