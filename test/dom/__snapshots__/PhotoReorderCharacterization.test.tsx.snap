exports[`T6.48 PhotoReorder markup (golden, pre-refactor) > keyboard select, move, escape, reset > deselected 1`] = `"<div class="flex flex-col gap-8"><p class="text-small text-grey-600 max-w-prose">Arrastrá las miniaturas, o elegí una (clic, Enter o Espacio) y movela con las flechas, Inicio/Fin o los botones “Mover antes/después”. Escape quita la selección. Los cambios se aplican al guardar.</p><p role="status" class="sr-only">IMG_3 movida a la posición 1 de 3.</p><div class="flex flex-wrap items-center gap-x-6 gap-y-2"><div role="group" aria-label="Vista" class="flex items-center gap-1.5"><span aria-hidden="true" class="text-micro text-grey-700 uppercase">Vista</span><button type="button" aria-pressed="true" class="text-micro text-grey-700 hover:text-ink border border-grey-300 hover:border-ink min-h-tap px-3 uppercase disabled:opacity-40 disabled:hover:border-grey-300 disabled:hover:text-grey-700 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink md:min-h-9 min-w-tap bg-ink border-ink text-paper hover:text-paper">Ajustar</button><button type="button" aria-pressed="false" class="text-micro text-grey-700 hover:text-ink border border-grey-300 hover:border-ink min-h-tap px-3 uppercase disabled:opacity-40 disabled:hover:border-grey-300 disabled:hover:text-grey-700 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink md:min-h-9 min-w-tap ">Rellenar</button></div><div role="group" aria-label="Tamaño" class="flex items-center gap-1.5"><span aria-hidden="true" class="text-micro text-grey-700 uppercase">Tamaño</span><button type="button" aria-pressed="false" aria-label="Pequeño" class="text-micro text-grey-700 hover:text-ink border border-grey-300 hover:border-ink min-h-tap px-3 uppercase disabled:opacity-40 disabled:hover:border-grey-300 disabled:hover:text-grey-700 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible