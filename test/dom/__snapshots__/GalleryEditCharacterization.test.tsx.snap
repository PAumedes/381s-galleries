<a href="/admin/g/g1/preview?device=desktop" target="_blank" rel="noopener noreferrer" title="Abre la galería tal como la ve un cliente (con lo guardado), aunque sea un borrador o tenga PIN." class="flex min-h-12 items-center justify-center gap-2 px-4 text-micro border-ink border uppercase md:min-h-10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-4">
