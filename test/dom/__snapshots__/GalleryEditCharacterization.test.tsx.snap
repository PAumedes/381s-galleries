<input id="ID5" aria-describedby="expires-note" class="border-grey-300 bg-white w-full border px-3 py-2 text-body aria-invalid:border-ink aria-invalid:border-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" type="date" value="2026-12-24" name="expiresDate">
</div>
<div class="flex flex-col gap-1">
<label for="ID6" class="text-small">Vence (hora)</label>
<input id="ID6" aria-describedby="expires-note" class="border-grey-300 bg-white w-full border px-3 py-2 text-body aria-invalid:border-ink aria-invalid:border-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" type="time" value="18:30" name="expiresTime">
</div>
</div>
<p id="expires-note" class="text-small text-grey-600">Hora local del estudio. Vacío = nunca vence. Sin hora, vence al final del día.</p>
