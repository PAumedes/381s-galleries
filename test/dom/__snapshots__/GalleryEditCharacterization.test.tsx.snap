<div class="flex flex-wrap gap-2">
<form method="post" action="/admin/g/g1" data-discover="true">
<input type="hidden" value="status" name="intent">
<input type="hidden" value="publish" name="to">
<button type="submit" class="text-micro uppercase border border-ink min-h-tap px-4 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink md:min-h-10 bg-ink text-paper">Publicar</button>
</form>
