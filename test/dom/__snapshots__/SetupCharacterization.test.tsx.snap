wed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">Volver a incluir</button></form></li><li class="flex flex-col gap-1"><span class="text-small text-grey-600">Eliminada el 01/10/2026 21:00</span><form method="post" action="/admin/setup" data-discover="true"><input type="hidden" value="reinclude" name="intent"><input type="hidden" value="1" name="confirm"><input type="hidden" value="h2" name="handle"><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">Volver a incluir</button></form></li></ul></section><p data-testid="build-id" class="text-small text-grey-600">Versión: dev</p></div>"`;

