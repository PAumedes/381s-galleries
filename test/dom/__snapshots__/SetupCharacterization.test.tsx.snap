exports[`SetupView pending logo previews (T6.47) > dark pick, then light pick: both previews are the picked files 1`] = `"<div class="flex flex-col gap-8"><h1 class="text-title text-ink">Ajustes</h1><div data-testid="setup-cards" class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4"><section class="border-grey-200 flex min-w-0 flex-col gap-3 border p-5"><h2 class="text-micro uppercase text-grey-700">Google Drive</h2><p class="text-body">Modo demo (Drive simulado)</p><div class="flex flex-wrap gap-2"><button type="button" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" disabled="">Conectar</button></div></section><section class="border-grey-200 flex min-w-0 flex-col gap-3 border p-5"><h2 class="text-micro uppercase text-grey-700">Carpeta raíz</h2><p class="text-body">Sin carpeta elegida</p><form method="post" action="/admin/setup" class="flex flex-col gap-3" data-discover="true"><input type="hidden" value="root" name="intent"><label class="text-small flex flex-col gap-1">Enlace o ID de la carpeta de Drive<input required="" maxlength="300" autocomplete="off" spellcheck="false" placeholder="https://drive.google.com/drive/folders/…" class="border-grey-300 bg-white w-full border px-3 py-2 text-body focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" name="folder"></label><p class="text-small text-grey-600">Al cambiar la carpeta raíz, las galerías que no estén en la nueva carpeta se van a archivar después del período de gracia (1 hora).</p><div><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink bg-ink text-paper">Guardar carpeta</button></div></form></section><section class="border-grey-200 flex min-w-0 flex-col gap-3 border p-5"><h2 class="text-micro uppercase text-grey-700">Sincronización</h2><p class="text-small text-grey-700">Sin sincronizar aún</p><form method="post" action="/admin/setup" data-discover="true"><input type="hidden" value="sync" name="intent"><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink bg-ink text-paper">Sincronizar ahora</button></form></section><section class="border-grey-200 flex min-w-0 flex-col gap-3 border p-5"><h2 class="text-micro uppercase text-grey-700">Marca</h2><form method="post" action="/admin/setup" class="flex flex-col gap-3" data-discover="true"><input type="hidden" value="studio" name="intent"><label class="text-small flex flex-col gap-1">Nombre del estudio<input required="" minlength="1" maxlength="60" class="border-grey-300 bg-white w-full border px-3 py-2 text-body focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" value="X" name="studioName"></label><div><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink bg-ink text-paper">Guardar nombre</button></div></form></section></div><section class="border-grey-200 flex min-w-0 flex-col gap-4 border p-5"><h2 class="text-micro uppercase text-grey-700">Logo</h2><p class="text-small text-grey-600">PNG, JPEG, WebP o SVG simple, hasta 512 KB. Sin logo para fondos oscuros se usa el de fondos claros en blanco.</p><p class="text-small text-grey-700">Logo predeterminado en uso</p><div class="grid grid-cols-1 gap-4 sm:grid-cols-2"><figure data-testid="logo-preview-light" class="flex min-w-0 flex-col gap-1"><div class="border-grey-300 flex h-28 items-center justify-center border p-3 bg-white"><img alt="Vista previa del logo" class="max-h-full max-w-full object-contain " draggable="false" src="blob:X"></div><figcaption class="text-small text-grey-600">Fondo claro</figcaption></figure><figure data-testid="logo-preview-dark" class="flex min-w-0 flex-col gap-1"><div class="border-grey-300 flex h-28 items-center justify-center border p-3 bg-black"><img alt="Vista previa del logo" class="max-h-full max-w-full object-contain " draggable="false" src="blob:X"></div><figcaption class="text-small text-grey-600">Fondo oscuro</figcaption></figure></div><div class="grid grid-cols-1 gap-6 md:grid-cols-2"><form method="post" action="/admin/setup" enctype="multipart/form-data" class="flex min-w-0 flex-col gap-3" data-discover="true"><input type="hidden" value="logo" name="intent"><input type="hidden" value="on-light" name="variant"><label class="text-small flex flex-col gap-1">Logo para fondos claros<input required="" accept="image/png,image/jpeg,image/webp,image/svg+xml" class="border-grey-300 bg-white w-full border px-3 py-2 text-body focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" type="file" name="file"></label><div><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink bg-ink text-paper">Subir logo</button></div></form><form method="post" action="/admin/setup" enctype="multipart/form-data" class="flex min-w-0 flex-col gap-3" data-discover="true"><input type="hidden" value="logo" name="intent"><input type="hidden" value="on-dark" name="variant"><label class="text-small flex flex-col gap-1">Logo para fondos oscuros (opcional)<input required="" accept="image/png,image/jpeg,image/webp,image/svg+xml" class="border-grey-300 bg-white w-full border px-3 py-2 text-body focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" type="file" name="file"></label><div><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink bg-ink text-paper">Subir logo</button></div></form></div><form method="post" action="/admin/setup" data-discover="true"><input type="hidden" value="logoReset" name="intent"><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" disabled="">Restablecer</button></form></section><section class="border-grey-200 flex min-w-0 flex-col gap-3 border p-5"><h2 class="text-micro uppercase text-grey-700">Carpetas ignoradas</h2><p class="text-small text-grey-600">Carpetas de galerías eliminadas. La sincronización no las vuelve a crear. De ellas solo se guardan el identificador de la carpeta y la fecha de eliminación.</p><p class="text-small">No hay carpetas ignoradas.</p></section><p data-testid="build-id" class="text-small text-grey-600">Versión: dev</p></div>"`;

