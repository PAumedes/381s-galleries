exports[`SetupView busy state and confirms (T6.47) > shows the syncing label (and disables the buttons) while the sync submits 1`] = `"<div class="flex flex-col gap-8"><h1 class="text-title text-ink">Ajustes</h1><div data-testid="setup-cards" class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4"><section class="border-grey-200 flex min-w-0 flex-col gap-3 border p-5"><h2 class="text-micro uppercase text-grey-700">Google Drive</h2><p class="text-body">Conectado</p><div class="flex flex-wrap gap-2"><a href="/admin/google/connect" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink bg-ink text-paper inline-block">Reconectar</a><form method="post" action="/admin/setup" data-discover="true"><input type="hidden" value="disconnect" name="intent"><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" disabled="">Desconectar</button></form></div></section><section class="border-grey-200 flex min-w-0 flex-col gap-3 border p-5"><h2 class="text-micro uppercase text-grey-700">Carpeta raíz</h2><p class="text-body">Carpeta actual: <strong>Mi Carpeta</strong></p><form method="post" action="/admin/setup" class="flex flex-col gap-3" data-discover="true"><input type="hidden" value="root" name="intent"><input type="hidden" value="1" name="confirm"><label class="text-small flex flex-col gap-1">Enlace o ID de la carpeta de Drive<input required="" maxlength="300" autocomplete="off" spellcheck="false" placeholder="https://drive.google.com/drive/folders/…" class="border-grey-300 bg-white w-full border px-3 py-2 text-body focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" name="folder"></label><p class="text-small text-grey-600">Al cambiar la carpeta raíz, las galerías que no estén en la nueva carpeta se van a archivar después del período de gracia (1 hora).</p><div><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink bg-ink text-paper" disabled="">Guardar carpeta</button></div></form></section><section class="border-grey-200 flex min-w-0 flex-col gap-3 border p-5"><h2 class="text-micro uppercase text-grey-700">Sincronización</h2><p class="text-small text-grey-700">Última sincronización: 01/11/2026 09:00</p><p data-testid="cache-warm" class="text-small text-grey-700">Fotos en caché: 3 / 10</p><p role="alert" class="text-small">Último error (02/11/2026 05:00): boom</p><form method="post" action="/admin/setup" data-discover="true"><input type="hidden" value="sync" name="intent"><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink bg-ink text-paper" disabled="">Sincronizando…</button></form></section><section class="border-grey-200 flex min-w-0 flex-col gap-3 border p-5"><h2 class="text-micro uppercase text-grey-700">Marca</h2><form method="post" action="/admin/setup" class="flex flex-col gap-3" data-discover="true"><input type="hidden" value="studio" name="intent"><label class="text-small flex flex-col gap-1">Nombre del estudio<input required="" minlength="1" maxlength="60" class="border-grey-300 bg-white w-full border px-3 py-2 text-body focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" value="381 Studios" name="studioName"></label><div><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink bg-ink text-paper" disabled="">Guardar nombre</button></div></form></section></div><section class="border-grey-200 flex min-w-0 flex-col gap-4 border p-5"><h2 class="text-micro uppercase text-grey-700">Logo</h2><p class="text-small text-grey-600">PNG, JPEG, WebP o SVG simple, hasta 512 KB. Sin logo para fondos oscuros se usa el de fondos claros en blanco.</p><p class="text-small text-grey-700">Logo propio en uso</p><div class="grid grid-cols-1 gap-4 sm:grid-cols-2"><figure data-testid="logo-preview-light" class="flex min-w-0 flex-col gap-1"><div class="border-grey-300 flex h-28 items-center justify-center border p-3 bg-white"><img alt="Vista previa del logo" class="max-h-full max-w-full object-contain " draggable="false" src="/brand/logo/on-light?v=v1"></div><figcaption class="text-small text-grey-600">Fondo claro</figcaption></figure><figure data-testid="logo-preview-dark" class="flex min-w-0 flex-col gap-1"><div class="border-grey-300 flex h-28 items-center justify-center border p-3 bg-black"><img alt="Vista previa del logo" class="max-h-full max-w-full object-contain brightness-0 invert" draggable="false" src="/brand/logo/on-light?v=v1"></div><figcaption class="text-small text-grey-600">Fondo oscuro</figcaption></figure></div><div class="grid grid-cols-1 gap-6 md:grid-cols-2"><form method="post" action="/admin/setup" enctype="multipart/form-data" class="flex min-w-0 flex-col gap-3" data-discover="true"><input type="hidden" value="logo" name="intent"><input type="hidden" value="on-light" name="variant"><label class="text-small flex flex-col gap-1">Logo para fondos claros<input required="" accept="image/png,image/jpeg,image/webp,image/svg+xml" class="border-grey-300 bg-white w-full border px-3 py-2 text-body focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" type="file" name="file"></label><div><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink bg-ink text-paper" disabled="">Subir logo</button></div></form><form method="post" action="/admin/setup" enctype="multipart/form-data" class="flex min-w-0 flex-col gap-3" data-discover="true"><input type="hidden" value="logo" name="intent"><input type="hidden" value="on-dark" name="variant"><label class="text-small flex flex-col gap-1">Logo para fondos oscuros (opcional)<input required="" accept="image/png,image/jpeg,image/webp,image/svg+xml" class="border-grey-300 bg-white w-full border px-3 py-2 text-body focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" type="file" name="file"></label><div><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink bg-ink text-paper" disabled="">Subir logo</button></div></form></div><form method="post" action="/admin/setup" data-discover="true"><input type="hidden" value="logoReset" name="intent"><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" disabled="">Restablecer</button></form></section><section class="border-grey-200 flex min-w-0 flex-col gap-3 border p-5"><h2 class="text-micro uppercase text-grey-700">Carpetas ignoradas</h2><p class="text-small text-grey-600">Carpetas de galerías eliminadas. La sincronización no las vuelve a crear. De ellas solo se guardan el identificador de la carpeta y la fecha de eliminación.</p><ul class="flex flex-col gap-3"><li class="flex flex-col gap-1"><span class="text-small text-grey-600">Eliminada el 30/09/2026 21:00</span><form method="post" action="/admin/setup" data-discover="true"><input type="hidden" value="reinclude" name="intent"><input type="hidden" value="1" name="confirm"><input type="hidden" value="h1" name="handle"><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" disabled="">Volver a incluir</button></form></li><li class="flex flex-col gap-1"><span class="text-small text-grey-600">Eliminada el 01/10/2026 21:00</span><form method="post" action="/admin/setup" data-discover="true"><input type="hidden" value="reinclude" name="intent"><input type="hidden" value="1" name="confirm"><input type="hidden" value="h2" name="handle"><button type="submit" class="text-micro uppercase border border-ink px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" disabled="">Volver a incluir</button></form></li></ul></section><p data-testid="build-id" class="text-small text-grey-600">Versión: dev</p></div>"`;

